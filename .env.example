# Copy to .env and adjust these host-side paths for your machine.
# They are bind-mounted into the container at /data/lampe/dataset and /data/lampe/model_v2.pth.
LAMPE_HOST_DATASET_DIR=/home/voidranjer/Documents/GitHub/lampe-cnn/dataset
LAMPE_HOST_MODEL_PATH=/home/voidranjer/Documents/GitHub/lampe-cnn/model_v2.pth

# Use a long random token when exposing Jupyter directly or through Cloudflare.
JUPYTER_TOKEN=replace-with-a-long-random-token

# Required only when running: docker compose --profile tunnel up --build
CLOUDFLARE_TUNNEL_TOKEN=replace-with-your-cloudflare-tunnel-token
